{
  "DataDirectory": "",
  "OneDrive": {
    "ClientId": "",
    "Tenant": "consumers"
  },
  "GoogleDrive": {
    "ClientSecretsPath": "client_secret.json"
  },
  "Matching": {
    "Modes": [ "exact" ],
    "AutoSelect": [ "exact" ],
    "SimilarThreshold": 8,
    "CrossCloudDownload": true,
    "CrossCloudMaxBytes": 524288000,
    "MaxParallelDownloads": 4,
    "MaxParallelThumbnails": 8
  },
  "Keep": {
    "Strategy": "oldest",
    "SimilarStrategy": "largest",
    "PathPriority": []
  }
}
