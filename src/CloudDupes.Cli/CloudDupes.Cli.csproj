<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\CloudDupes.Core\CloudDupes.Core.csproj" />
    <ProjectReference Include="..\CloudDupes.Providers.OneDrive\CloudDupes.Providers.OneDrive.csproj" />
    <ProjectReference Include="..\CloudDupes.Providers.GoogleDrive\CloudDupes.Providers.GoogleDrive.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.14" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.14" />
    <PackageReference Include="System.CommandLine" Version="2.0.14" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>clouddupes</AssemblyName>
    <RootNamespace>CloudDupes.Cli</RootNamespace>
    <UserSecretsId>clouddupes-cli</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="client_secret.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('client_secret.json')" />
  </ItemGroup>

</Project>
